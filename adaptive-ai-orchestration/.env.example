# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB?sslmode=require
AWS_REGION=us-east-1
# Prefer the AWS credential chain (profile/role); do not commit AWS keys.
ROUTING_POLICY=static
EVALUATION_SAMPLE_RATE=0.2
RAG_SIMILARITY_THRESHOLD=0.75
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Register your administrator first, then configure their username here.
ADMIN_USERNAMES=
# Memory rate limiting is single-process; configure Redis for multiple API workers.
RATE_LIMIT_STORAGE_URI=memory://
# Override illustrative rates with verified USD per 1K input/output tokens:
# MODEL_PRICING_JSON={"nova-micro":{"input":0.000035,"output":0.000140},"llama3-8b":{"input":0.000220,"output":0.000220},"llama3-70b":{"input":0.000720,"output":0.000720},"titan-embed-v2":{"input":0.000020,"output":0}}
